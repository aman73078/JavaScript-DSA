{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run JavaScript",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "node \"${file}\" < input.txt > output.txt"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}

